{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fringe-ledger-scan-status",
  "main": "worker/status.js",
  "compatibility_date": "2026-08-12",
  "no_bundle": true,
  "kv_namespaces": [
